  ],
  [
   "usb.GND",
   "ldo.GND",
   "ldo2.GND",
   "core.GND",
   "led.GND",
   "voc.GND",
   "qwiic.GND",
   "pm.GND",
   "co2.GND"
  ],
  [
   "usb./USB_D+",
   "core./USB_D+"
  ],
  [
   "usb./USB_D-",
   "core./USB_D-"
  ],
